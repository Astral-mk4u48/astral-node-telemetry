{
  "version": 2,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/server.js?path=/api/:path*" },
    { "source": "/health", "destination": "/server.js?path=/health" },
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ]
}
